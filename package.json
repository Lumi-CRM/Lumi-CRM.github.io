{
  "name": "lumi-crm",
  "private": true,
  "version": "1.2.0",
  "description": "LumiCRM — облачный офис для специалистов по недвижимости",
  "author": "Lumi-CRM",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-spa-fallback.mjs",
    "build:sites": "npm run build && node scripts/prepare-sites-build.mjs",
    "build:android": "npm run build && cap sync android",
    "build:desktop:web": "tsc -b && vite build --base=./ --outDir=dist-desktop",
    "build:desktop": "npm run build:desktop:web && electron-builder --win nsis --publish never",
    "test": "node --test src/lib/authGuards.test.ts src/lib/authCallback.test.ts src/lib/offlineTransport.test.ts src/lib/dealFinance.test.ts src/lib/dealParticipants.test.ts src/lib/dealMapping.test.ts src/lib/planProgress.test.ts src/lib/monthlyPlanMapping.test.ts src/lib/recordCollectionMapping.test.ts src/lib/workspaceBackup.test.ts src/lib/navigation.test.ts src/lib/contacts.test.ts src/lib/propertyMapping.test.ts src/lib/propertyRecordMapping.test.ts src/lib/workspaceSearch.test.ts src/lib/taskMapping.test.ts src/lib/eventMapping.test.ts src/lib/callActivityMapping.test.ts src/lib/syncDiagnostics.test.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "import:sheets": "node scripts/import-google-sheet.mjs",
    "import:sheets:sql": "node scripts/generate-google-sheet-sql.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.11.0",
    "tailwind-merge": "^2.5.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.lumicrm.office",
    "productName": "LumiCRM",
    "artifactName": "LumiCRM-Windows-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-desktop/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon-512-v2.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "LumiCRM"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://lumi-crm.github.io/downloads/",
        "channel": "latest"
      }
    ]
  }
}
